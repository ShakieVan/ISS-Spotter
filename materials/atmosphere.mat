material {
    name : AtmosphereShell,
    shadingModel : unlit,
    blending : add,
    culling : back,
    depthWrite : false,
    requires : [ uv0 ],
    parameters : [
        { type : float3, name : sunDirection },
        { type : float3, name : cameraPosition }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = getUV0();

        // 1. Exact analytic sphere normal and position of this fragment on the atmosphere shell (R = 10.22)
        float theta = (1.0 - uv.y) * 3.141592653589793;
        float phi = (uv.x - 0.5) * 6.283185307179586;
        float sinTheta = sin(theta);
        float cosTheta = cos(theta);
        float3 N_sphere = float3(
            sinTheta * cos(phi),
            cosTheta,
            -sinTheta * sin(phi)
        );

        float RA = 10.22;
        float RE = 10.00;
        float3 P = N_sphere * RA;

        // 2. Camera position in world space and normalized ray direction
        float3 C = materialParams.cameraPosition;
        float3 V = normalize(P - C);
        float3 sunDir = normalize(materialParams.sunDirection);

        // 3. Distance of closest approach of ray (C + t*V) to Earth center (0,0,0)
        float tClosest = -dot(C, V);
        if (tClosest <= 0.0) {
            material.baseColor = float4(0.0);
            return;
        }

        float3 Pclosest = C + V * tClosest;
        float d2 = dot(Pclosest, Pclosest);
        float d = sqrt(d2);

        // If the ray hits the solid Earth body (d < RE) or misses atmosphere (d >= RA):
        if (d < RE || d >= RA) {
            material.baseColor = float4(0.0);
            return;
        }

        // Ray passes through atmospheric limb above solid Earth: 10.0 <= d < 10.22
        float h = (d - RE) / (RA - RE); // 0.0 at surface, 1.0 at outer rim
        float pathLength = 2.0 * sqrt(max(RA * RA - d2, 0.0));
        // Exponential Rayleigh density profile
        float scatter = exp(-h * 4.2) * (1.0 - smoothstep(0.75, 1.0, h)) * pathLength * 0.45;

        // Illumination at the closest approach limb point
        float3 N_atmo = normalize(Pclosest);
        float sunDot = dot(N_atmo, sunDir);

        // Rayleigh scattering blue on day side
        float3 rayleighBlue = float3(0.18, 0.58, 1.00);

        // Sunset / Twilight spectrum
        float sunsetBand = smoothstep(-0.18, 0.02, sunDot) * (1.0 - smoothstep(0.02, 0.22, sunDot));
        float sunsetGrad = clamp((sunDot + 0.16) / 0.24, 0.0, 1.0);
        float3 sunsetColor = mix(float3(0.96, 0.22, 0.06), float3(1.00, 0.65, 0.18), sunsetGrad);

        // Night side airglow
        float3 nightAirglow = float3(0.015, 0.045, 0.080) * 0.35;

        float3 litColor = mix(rayleighBlue, sunsetColor, sunsetBand * 0.92);
        float3 finalLimbColor = mix(nightAirglow, litColor, smoothstep(-0.20, 0.08, sunDot));

        float3 finalGlow = finalLimbColor * scatter * 2.2;
        material.baseColor = float4(finalGlow, 1.0);
    }
}
