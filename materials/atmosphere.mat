material {
    name : VolumetricAtmosphere,
    shadingModel : unlit,
    blending : add,
    culling : none,
    depthWrite : false,
    parameters : [
        { type : float3, name : sunDirection },
        { type : float3, name : cameraPosition }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // 1. Perspective View Ray from Camera into the scene
        float3 C = materialParams.cameraPosition;
        float3 V = -normalize(getWorldViewVector());
        float3 sunDir = normalize(materialParams.sunDirection);

        float RE = 10.00; // Earth surface radius
        float RA = 10.22; // Outer atmosphere radius (140 km)

        // 2. Ray-Sphere Intersection with Earth (RE) and Atmosphere (RA)
        // Ray equation: P(t) = C + t * V
        // Closest approach to origin (0, 0, 0):
        float tClosest = -dot(C, V);
        if (tClosest <= 0.0) {
            material.baseColor = float4(0.0);
            return;
        }

        float3 Pclosest = C + V * tClosest;
        float d2 = dot(Pclosest, Pclosest);
        float d = sqrt(d2);

        // Skip rays deep inside solid Earth (d < 9.85) or missing atmosphere (d >= RA)
        // Allowing 9.85 <= d < 10.00 ensures seamless anti-aliasing under the Earth mesh edge
        if (d < 9.85 || d >= RA) {
            material.baseColor = float4(0.0);
            return;
        }

        // 3. Volumetric Raymarching through atmospheric limb
        // Ray enters atmosphere shell at t_in and exits at t_out:
        float halfChordA = sqrt(max(RA * RA - d2, 0.0));
        float t_in = max(tClosest - halfChordA, 0.0);
        float t_out = tClosest + halfChordA;
        float stepSize = (t_out - t_in) / 10.0;

        // Rayleigh scattering wavelength constants (standard Earth atmosphere: 700nm, 530nm, 440nm)
        float3 betaR = float3(0.18, 0.52, 1.00) * 1.8;

        // Rayleigh phase function: P(cos_theta) = 3/(16*pi) * (1 + cos^2(theta))
        float cosThetaSun = dot(V, sunDir);
        float phaseR = 0.75 * (1.0 + cosThetaSun * cosThetaSun);

        // Sunset / Sunrise reddening
        float3 sunsetColor = float3(1.00, 0.45, 0.12);

        float3 totalScatter = float3(0.0);

        // 10-step numerical integration along the view ray
        for (int i = 0; i < 10; i++) {
            float t = t_in + (float(i) + 0.5) * stepSize;
            float3 samplePos = C + V * t;
            float rSample = length(samplePos);

            if (rSample >= RE && rSample <= RA) {
                float h = (rSample - RE) / (RA - RE); // 0.0 to 1.0
                // Exponential barometric density profile (scale height H ~ 8km -> h*4.5)
                float density = exp(-h * 4.5);

                // Sun illumination at sample point:
                // Check if Earth occludes Sun from this sample point (shadow cone)
                float3 sampleNormal = samplePos / rSample;
                float sunDotSample = dot(sampleNormal, sunDir);

                float inShadow = 0.0;
                if (sunDotSample < 0.0) {
                    float3 sunPerp = samplePos - dot(samplePos, sunDir) * sunDir;
                    if (dot(sunPerp, sunPerp) < RE * RE) {
                        inShadow = 1.0;
                    }
                }

                if (inShadow < 0.5) {
                    float sunElevation = clamp((sunDotSample + 0.08) / 0.25, 0.0, 1.0);
                    float3 sunLightAtSample = mix(sunsetColor * 0.85, float3(1.0), sunElevation);

                    totalScatter += density * sunLightAtSample * stepSize;
                }
            }
        }

        float3 limbColor = totalScatter * betaR * phaseR * 0.65;
        material.baseColor = float4(limbColor, 1.0);
    }
}
