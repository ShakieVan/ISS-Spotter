material {
    name : SunFlare,
    shadingModel : unlit,
    blending : add,
    culling : none,
    depthWrite : false,
    requires : [ uv0 ],
    parameters : [
        { type : float, name : intensity }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 coord = getUV0() * 2.0 - 1.0;
        float r = length(coord);
        if (r >= 1.0) {
            material.baseColor = float4(0.0);
            return;
        }

        // Smooth windowing that is guaranteed to reach 0.0 well before the mesh boundary
        float edgeFade = smoothstep(1.0, 0.20, r);
        edgeFade = edgeFade * edgeFade;

        float intens = max(materialParams.intensity, 0.1);

        // 1. Solar Photosphere Core (blinding intense white light)
        float core = exp(-pow(r * 20.0, 2.0));
        float3 coreColor = float3(95.0, 95.0, 92.0) * core;

        // 2. Solar Corona & Bloom (compact golden radiating glow)
        float corona = exp(-pow(r * 5.5, 1.4)) * 4.5;
        float3 coronaColor = float3(5.5, 4.0, 2.0) * corona;

        // Total additive HDR color with guaranteed smooth edge fade to 0
        float3 totalRgb = (coreColor + coronaColor) * intens * edgeFade;

        material.baseColor = float4(totalRgb, 1.0);
    }
}
