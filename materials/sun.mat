material {
    name : SunFlare,
    shadingModel : unlit,
    blending : add,
    culling : none,
    depthWrite : false,
    requires : [ uv0 ],
    parameters : [
        { type : float, name : intensity },
        { type : float, name : time }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 coord = getUV0() * 2.0 - 1.0;
        float r = length(coord);
        if (r >= 1.0) {
            material.baseColor = float4(0.0);
            return;
        }

        // Ultra-soft, seamless cubic falloff guaranteeing zero visible boundary
        float w = clamp(1.0 - r, 0.0, 1.0);
        float edgeFade = w * w * (3.0 - 2.0 * w);
        edgeFade = edgeFade * edgeFade;

        float intens = max(materialParams.intensity, 0.1);

        // 1. Solar Photosphere Core (blinding intense white light)
        float core = exp(-pow(r * 22.0, 2.0));
        float3 coreColor = float3(98.0, 98.0, 92.0) * core;

        // 2. Solar Corona & Bloom: ultra-soft diffuse golden glow with animated shimmer
        float t = materialParams.time;
        float pulse = 1.0 + 0.05 * sin(t * 2.0);
        float rPulse = r * pulse;

        // Long-tail inverse power falloff: washed out and smooth with zero perceptible edge
        float coronaInner = 1.0 / (1.0 + pow(rPulse * 16.0, 2.0));
        float coronaOuter = 1.0 / (1.0 + pow(rPulse * 5.0, 1.7));
        float3 coronaColor = float3(4.2, 3.2, 1.2) * coronaInner + float3(0.85, 0.45, 0.10) * coronaOuter;

        // Total additive HDR color with seamless fade to black
        float3 totalRgb = (coreColor + coronaColor) * intens * edgeFade;

        material.baseColor = float4(totalRgb, 1.0);
    }
}
