material {
    name : SunFlare,
    shadingModel : unlit,
    blending : add,
    culling : none,
    depthWrite : false,
    requires : [ uv0 ],
    parameters : [
        { type : float, name : intensity }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 coord = getUV0() * 2.0 - 1.0;
        float r = length(coord);
        if (r > 1.0) {
            material.baseColor = float4(0.0);
            return;
        }

        float intens = max(materialParams.intensity, 0.1);

        // 1. Solar Core Photosphere (blinding, intense white)
        float coreDisk = exp(-pow(r * 14.0, 2.0));
        float3 coreColor = float3(28.0, 27.5, 26.5) * coreDisk;

        // 2. Solar Corona & Bloom (golden amber radiating glow)
        float innerCorona = pow(clamp(1.0 - r * 2.2, 0.0, 1.0), 3.0) * 4.5;
        float3 innerColor = float3(3.6, 2.8, 1.6) * innerCorona;

        float outerCorona = pow(clamp(1.0 - r, 0.0, 1.0), 4.5) * 2.2;
        float3 outerColor = float3(1.6, 1.0, 0.45) * outerCorona;

        // 3. Horizontal Anamorphic Lens Flare Streak (iconic NASA space camera flare)
        float streakH = exp(-pow(coord.y * 36.0, 2.0)) * exp(-pow(coord.x * 1.6, 2.0));
        float3 streakColor = float3(0.45, 0.85, 1.35) * streakH * 4.8;

        // 4. Optical Diffraction Spikes (4-point cardinal cross + diagonal micro-spikes)
        float angle = atan(coord.y, coord.x);
        float ray4 = pow(abs(cos(angle * 2.0)), 40.0) * pow(clamp(1.0 - r, 0.0, 1.0), 1.8) * 2.4;
        float rayDiag = pow(abs(cos(angle * 2.0 + 0.785398)), 54.0) * pow(clamp(1.0 - r * 1.3, 0.0, 1.0), 2.2) * 1.2;
        float3 rayColor = float3(2.2, 1.9, 1.4) * (ray4 + rayDiag);

        // 5. Chromatic Aperture Rainbow Ring
        float ringDist = abs(r - 0.42);
        float3 ringColor = float3(
            smoothstep(0.045, 0.0, abs(r - 0.44)),
            smoothstep(0.045, 0.0, abs(r - 0.42)),
            smoothstep(0.045, 0.0, abs(r - 0.40))
        ) * 1.8;

        // 6. Secondary Lens Flare Ghost Reflexes
        float2 ghost1Coord = coord + float2(0.22, 0.12);
        float ghost1 = exp(-dot(ghost1Coord, ghost1Coord) * 60.0) * 0.45;
        float2 ghost2Coord = coord - float2(0.32, 0.18);
        float ghost2 = exp(-dot(ghost2Coord, ghost2Coord) * 35.0) * 0.35;
        float3 ghostColor = float3(0.35, 0.75, 1.20) * ghost1 + float3(1.10, 0.55, 0.20) * ghost2;

        // Total additive HDR color
        float3 totalRgb = (coreColor + innerColor + outerColor + streakColor + rayColor + ringColor + ghostColor) * intens;

        material.baseColor = float4(totalRgb, 1.0);
    }
}
