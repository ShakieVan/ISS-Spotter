material {
    name : EarthAtmosphere,
    shadingModel : unlit,
    blending : opaque,
    flipUV : true,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : dayMap },
        { type : sampler2d, name : nightMap },
        { type : sampler2d, name : cloudMap },
        { type : sampler2d, name : borderMap },
        { type : float3, name : sunDirection },
        { type : float, name : time },
        { type : float, name : cloudRelief },
        { type : float, name : showBorders },
        { type : float, name : showClouds },
        { type : float, name : isReferenceMode },
        { type : float, name : debugVisualMode },
        { type : float, name : cloudEncoding },
        { type : float, name : cloudNoDataMode },
        { type : float, name : mapLightingMode }
    ]
}

fragment {
    // Dedicated cloud opacity and validity evaluation (Preserving NoData)
    // Decouples explicit channel encoding (Grayscale vs. Alpha) from NoData validity.
    struct CloudSample {
        float opacity;
        float isValid; // 1.0 = observation present, 0.0 = NoData
    };

    CloudSample sampleCloud(float2 coords) {
        float4 cSample = texture(materialParams_cloudMap, coords);
        float isValid = 1.0;

        // 1. NoData evaluation (isolated from cloud opacity)
        if (materialParams.cloudNoDataMode > 0.5 && materialParams.cloudNoDataMode < 1.5) {
            // NODATA_ALPHA_ZERO: unobserved / missing observation
            if (cSample.a < 0.001) {
                isValid = 0.0;
            }
        } else if (materialParams.cloudNoDataMode >= 1.5) {
            // NODATA_SENTINEL_ZERO: RGB=(0,0,0) unobserved swath boundary
            if (dot(cSample.rgb, cSample.rgb) < 0.0001) {
                isValid = 0.0;
            }
        }

        // 2. Explicit cloud encoding without heuristics:
        // 0.0 = GRAYSCALE_MASK: brightness from defined grayscale/red channel (JPEG)
        // 1.0 = CLOUD_ALPHA_MASK: cloud opacity directly from alpha, strictly [0.0, 1.0]
        float raw = (materialParams.cloudEncoding > 0.5) ? cSample.a : cSample.r;
        float opacity = clamp(raw, 0.0, 1.0);

        CloudSample result;
        result.opacity = opacity;
        result.isValid = isValid;
        return result;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = getUV0();

        // 1. Continuous surface normal reconstructed from UV mapping.
        // Mesh: North Pole has v=1.0, Equator has v=0.5, South Pole has v=0.0.
        // Filament flipUV=true: Shader has uv.y=0.0 at North Pole, uv.y=1.0 at South Pole.
        float theta = uv.y * 3.141592653589793;
        float phi = (uv.x - 0.5) * 6.283185307179586;
        float sinTheta = sin(theta);
        float cosTheta = cos(theta);
        float3 normal = float3(
            sinTheta * cos(phi),
            cosTheta,
            -sinTheta * sin(phi)
        );
        float latDeg = (0.5 - uv.y) * 180.0;

        float3 eyeDir = normalize(getWorldViewVector());
        float3 sunDir = normalize(materialParams.sunDirection);
        float sunDot = dot(normal, sunDir);

        // =========================================================
        // SHADER DIAGNOSTIC OUTPUTS
        // =========================================================
        // 1.0: Normal as RGB (North=+Y -> Green, South=-Y -> Purple, East=-Z -> Yellow-Green, West=+Z -> Cyan)
        if (materialParams.debugVisualMode > 0.5 && materialParams.debugVisualMode < 1.5) {
            material.baseColor = float4(normal * 0.5 + 0.5, 1.0);
            return;
        }
        // 2.0: sunDot as grayscale: 1.0=noon, 0.5=terminator, 0.0=midnight
        if (materialParams.debugVisualMode >= 1.5 && materialParams.debugVisualMode < 2.5) {
            float sVal = clamp(sunDot * 0.5 + 0.5, 0.0, 1.0);
            material.baseColor = float4(float3(sVal), 1.0);
            return;
        }
        // 3.0: Shader UV coordinates as RG (U -> Red, V -> Green)
        if (materialParams.debugVisualMode >= 2.5 && materialParams.debugVisualMode < 3.5) {
            material.baseColor = float4(uv.x, uv.y, 0.0, 1.0);
            return;
        }
        // 4.0: Raw cloud texture RGB
        if (materialParams.debugVisualMode >= 3.5 && materialParams.debugVisualMode < 4.5) {
            float4 rawCloud = texture(materialParams_cloudMap, uv);
            material.baseColor = float4(rawCloud.rgb, 1.0);
            return;
        }
        // 5.0: Evaluated mask channel (Grayscale or Alpha depending on cloudEncoding)
        if (materialParams.debugVisualMode >= 4.5 && materialParams.debugVisualMode < 5.5) {
            CloudSample cs = sampleCloud(uv);
            material.baseColor = float4(float3(cs.opacity), 1.0);
            return;
        }
        // 6.0: Validity mask (Green = valid observation, Magenta = NoData)
        if (materialParams.debugVisualMode >= 5.5 && materialParams.debugVisualMode < 6.5) {
            CloudSample cs = sampleCloud(uv);
            float3 valColor = (cs.isValid > 0.5) ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 1.0);
            material.baseColor = float4(valColor, 1.0);
            return;
        }
        float4 daySample = texture(materialParams_dayMap, uv);
        float4 borderSample = texture(materialParams_borderMap, uv);

        // 7.0: Effective cloud opacity after NoData filtering
        if (materialParams.debugVisualMode >= 6.5 && materialParams.debugVisualMode < 7.5) {
            CloudSample cs = sampleCloud(uv);
            float eff = (cs.isValid > 0.5) ? cs.opacity : 0.0;
            material.baseColor = float4(float3(eff), 1.0);
            return;
        }
        // 8.0: satDayMask on VIIRS (1.0 = satellite day, 0.0 = night)
        if (materialParams.debugVisualMode >= 7.5 && materialParams.debugVisualMode < 8.5) {
            float sMask = smoothstep(-0.06, 0.06, sunDot);
            material.baseColor = float4(float3(sMask), 1.0);
            return;
        }
        // 9.0: VIIRS Ocean / Water detection mask
        if (materialParams.debugVisualMode >= 8.5) {
            float isWater = clamp((daySample.b - max(daySample.r * 1.15, daySample.g * 0.95)) * 12.0, 0.0, 1.0);
            float lum = dot(daySample.rgb, float3(0.299, 0.587, 0.114));
            isWater *= smoothstep(0.42, 0.18, lum);
            material.baseColor = float4(float3(isWater), 1.0);
            return;
        }

        // =========================================================
        // A. SATELLITE / RAW MAP REFERENCE VIEW (Technisch neutral)
        // =========================================================
        // In reference mode, the texture is displayed raw and color-faithful
        // without artificial solar darkening, night lights, or simulated lighting.
        if (materialParams.isReferenceMode > 0.5) {
            float3 refColor = daySample.rgb;
            if (materialParams.showBorders > 0.01 && borderSample.a > 0.01) {
                float bgLum = dot(refColor, float3(0.299, 0.587, 0.114));
                float3 invertedColor = float3(1.0) - refColor;
                float3 highContrast = (bgLum > 0.42) 
                    ? float3(0.08, 0.10, 0.14) 
                    : float3(0.92, 0.96, 1.00);
                float3 borderCol = mix(invertedColor, highContrast, 0.75);
                refColor = mix(refColor, borderCol, borderSample.a * materialParams.showBorders);
            }
            material.baseColor = float4(refColor, 1.0);
            return;
        }

        // =========================================================
        // B. VIIRS TRUECOLOR VISUAL / REALISTIC
        // =========================================================
        // VIIRS TrueColor is an optically illuminated satellite observation mosaic.
        // DO NOT re-light with surfaceDayLight * directSunColor * shadowFactor.
        // Day side retains natural, brilliant satellite brightness.
        if (materialParams.mapLightingMode > 0.5) {
            float3 satelliteDay = daySample.rgb;

            // 1. Controlled, subtle sun glint on ocean only
            // Water detection on VIIRS: low red/green, higher blue, low overall luminance
            float isWater = clamp((daySample.b - max(daySample.r * 1.15, daySample.g * 0.95)) * 12.0, 0.0, 1.0);
            float lum = dot(daySample.rgb, float3(0.299, 0.587, 0.114));
            isWater *= smoothstep(0.42, 0.18, lum);

            float3 reflected = reflect(-sunDir, normal);
            float specAngle = max(dot(reflected, eyeDir), 0.0);
            float sunAboveHorizon = smoothstep(0.02, 0.15, sunDot);
            // Subtle, non-overpowering ocean specular reflection
            float viirsGlint = pow(specAngle, 96.0) * isWater * sunAboveHorizon * 0.35;
            float3 glintColor = float3(1.0, 0.98, 0.95) * viirsGlint;

            // 2. Sunset/twilight warmth near terminator (only in twilight band [-0.04, 0.12])
            float sunsetFactor = smoothstep(-0.04, 0.02, sunDot) * (1.0 - smoothstep(0.02, 0.12, sunDot));
            float3 sunsetTint = mix(float3(1.0), float3(1.05, 0.78, 0.52), sunsetFactor * 0.40);
            float3 litSatelliteDay = satelliteDay * sunsetTint + glintColor;

            // 3. Night side with night lights and faint starlight/ambient
            float4 nightSample = texture(materialParams_nightMap, uv);
            float3 nightSide = nightSample.rgb * 2.8;
            float3 nightAmbient = satelliteDay * 0.012 * float3(0.35, 0.50, 0.75);
            float3 surfaceNight = nightSide + nightAmbient;

            // 4. Smooth terminator transition without darkening the day side:
            // For sunDot >= 0.06: satDayMask is strictly 1.0 (original satellite brightness).
            // For sunDot <= -0.06: satDayMask is strictly 0.0 (night lights).
            float satDayMask = smoothstep(-0.06, 0.06, sunDot);
            float3 surfaceColor = mix(surfaceNight, litSatelliteDay, satDayMask);

            // 5. Inverted high-contrast borders & country labels (if enabled)
            if (materialParams.showBorders > 0.01 && borderSample.a > 0.01) {
                float bgLum = dot(surfaceColor, float3(0.299, 0.587, 0.114));
                float3 invertedColor = float3(1.0) - surfaceColor;
                float3 highContrast = (bgLum > 0.42) 
                    ? float3(0.08, 0.10, 0.14) 
                    : float3(0.92, 0.96, 1.00);
                float3 borderCol = mix(invertedColor, highContrast, 0.75);
                float borderAlpha = borderSample.a * materialParams.showBorders;
                surfaceColor = mix(surfaceColor, borderCol, borderAlpha);
            }

            material.baseColor = float4(surfaceColor, 1.0);
            return;
        }

        // =========================================================
        // C. BLUE MARBLE ALBEDO SIMULATION
        // =========================================================
        // Full physical simulation with dynamic solar lighting, clouds, shadows, and glint.

        // =========================================================
        // 1. DAY / TWILIGHT / NIGHT TRANSITION & SUNSET SPECTRUM
        // =========================================================
        // Ground daylight factor: smooth physical transition across terminator [-0.03, 0.08]
        float dayFactor = smoothstep(-0.03, 0.08, sunDot);

        // Physical Lambertian cosine factor for direct sunlight (strictly monotonic, 0 at sunset)
        float sunLambert = clamp(sunDot * 1.25, 0.0, 1.0);

        // Sunset / Sunrise atmospheric reddening (Rayleigh extinction along path through atmosphere)
        float3 sunsetColor = float3(1.00, 0.65, 0.28);
        float3 directSunColor = mix(sunsetColor, float3(1.0, 0.98, 0.95), smoothstep(0.02, 0.20, sunDot));

        // =========================================================
        // 2. TEXTURE SAMPLES & SURFACE LIGHTING
        // =========================================================
        float4 nightSample = texture(materialParams_nightMap, uv);

        // Clean, linear cloud opacity evaluation with NoData awareness
        CloudSample cSample = sampleCloud(uv);
        float effectiveOpacity = (cSample.isValid > 0.5) ? cSample.opacity : 0.0;
        float cloudAlpha = effectiveOpacity * materialParams.showClouds;

        // Cloud shadow on Earth surface (strictly using the exact same evaluation function)
        float2 shadowUv = uv - float2(sunDir.x, -sunDir.y) * 0.0035;
        CloudSample shadowSample = sampleCloud(shadowUv);
        float effectiveShadowOpacity = (shadowSample.isValid > 0.5) ? shadowSample.opacity : 0.0;
        float shadowAlpha = effectiveShadowOpacity * materialParams.showClouds;
        float shadowFactor = 1.0 - shadowAlpha * 0.55 * max(sunDot, 0.0);

        // Specular sun glint on ocean: strictly confined to open ocean, strictly daytime, physically bounded
        float isOcean = clamp((daySample.b - max(daySample.r, daySample.g) - 0.02) * 10.0, 0.0, 1.0);
        float sunAboveHorizon = smoothstep(0.01, 0.10, sunDot);
        float3 reflected = reflect(-sunDir, normal);
        float specAngle = max(dot(reflected, eyeDir), 0.0);
        float sunGlint = pow(specAngle, 128.0) * isOcean * sunAboveHorizon * (1.0 - cloudAlpha);
        float3 glintColor = directSunColor * sunGlint * 0.85;

        // Night city lights occlusion by clouds:
        float cloudLightBlock = smoothstep(0.15, 0.85, cloudAlpha) * 0.85;
        float3 nightLights = nightSample.rgb * 2.8 * (1.0 - cloudLightBlock);
        // Soft under-cloud city light scatter
        float3 cityUnderGlow = nightSample.rgb * 0.35 * cloudAlpha;

        // Day surface lighting: physical Lambert falloff ensures daylight smoothly and monotonically fades to dusk
        float surfaceDayLight = mix(0.04, 1.0, sunLambert);
        float3 surfaceDay = daySample.rgb * shadowFactor * directSunColor * surfaceDayLight + glintColor;

        // Night terrain ambient starlight
        float3 nightAmbient = daySample.rgb * 0.018 * float3(0.35, 0.50, 0.75);
        float3 surfaceNight = nightLights + nightAmbient;
        float3 surfaceColor = mix(surfaceNight, surfaceDay, dayFactor);

        // =========================================================
        // 3. REALISTIC 3D CLOUDS (DAY, SUNSET & NIGHT)
        // =========================================================
        float cloudSunDot = sunDot + 0.03;
        float cloudSunFactor = smoothstep(-0.04, 0.08, cloudSunDot);

        float stormHeight = smoothstep(0.4, 0.9, cloudAlpha) * materialParams.cloudRelief;
        float cloudDiffuse = clamp(sunLambert * 1.1 + stormHeight * 0.20, 0.0, 1.0);

        // Daylight clouds: crisp white with realistic ambient shading (monotonically dims with sun height)
        float3 cloudDayColor = mix(float3(0.55, 0.65, 0.78), float3(0.98, 0.99, 1.0), cloudDiffuse) * (0.15 + 0.85 * cloudDiffuse);

        // Sunset clouds: subtle amber warmth, dimmed in line with lower solar angle
        float sunsetBand = smoothstep(-0.02, 0.05, sunDot) * (1.0 - smoothstep(0.05, 0.18, sunDot));
        float3 cloudSunsetColor = sunsetColor * 0.75;
        float3 cloudLitColor = mix(cloudDayColor, cloudSunsetColor, sunsetBand * 0.80);

        // Night side clouds in Earth shadow
        float3 cloudNightColor = float3(0.010, 0.014, 0.020) + cityUnderGlow;

        // Final cloud color blended smoothly across terminator into night
        float3 cloudColor = mix(cloudNightColor, cloudLitColor, cloudSunFactor);

        // Apply clouds over Earth surface
        surfaceColor = mix(surfaceColor, cloudColor, cloudAlpha);

        // Final surface color: crystal-clear terrain and clouds, no artificial surface glow
        float3 finalColor = surfaceColor;

        // =========================================================
        // 5. INVERTED HIGH-CONTRAST BORDERS & COUNTRY LABELS
        // =========================================================
        if (materialParams.showBorders > 0.01 && borderSample.a > 0.01) {
            // Luminance of the underlying pixel (surface, clouds, city lights, atmosphere)
            float bgLum = dot(finalColor, float3(0.299, 0.587, 0.114));

            // Dynamic inverted color of the underlying surface
            float3 invertedColor = float3(1.0) - finalColor;

            // Guaranteed high-contrast target (pure dark charcoal on bright surfaces, luminous bright on dark)
            float3 highContrast = (bgLum > 0.42) 
                ? float3(0.08, 0.10, 0.14) 
                : float3(0.92, 0.96, 1.00);

            // Blend inverted with high-contrast target for maximum legibility and style
            float3 borderCol = mix(invertedColor, highContrast, 0.75);

            // Clean anti-aliased border alpha blending
            float borderAlpha = borderSample.a * materialParams.showBorders;
            finalColor = mix(finalColor, borderCol, borderAlpha);
        }

        material.baseColor = float4(finalColor, 1.0);
    }
}
