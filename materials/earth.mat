material {
    name : EarthAtmosphere,
    shadingModel : unlit,
    blending : opaque,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : dayMap },
        { type : sampler2d, name : nightMap },
        { type : sampler2d, name : cloudMap },
        { type : sampler2d, name : borderMap },
        { type : float3, name : sunDirection },
        { type : float, name : time },
        { type : float, name : cloudRelief },
        { type : float, name : showBorders },
        { type : float, name : showClouds }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = getUV0();
        // 1. Precise continuous surface normal from world position (sphere centered at origin)
        float3 normal = normalize(getWorldPosition());
        float3 eyeDir = normalize(getWorldViewVector());
        float3 sunDir = normalize(materialParams.sunDirection);

        float sunDot = dot(normal, sunDir);

        // =========================================================
        // 1. DAY / TWILIGHT / NIGHT TRANSITION & SUNSET SPECTRUM
        // =========================================================
        // Ground daylight factor: smooth physical transition across terminator [-0.03, 0.08]
        float dayFactor = smoothstep(-0.03, 0.08, sunDot);

        // Physical Lambertian cosine factor for direct sunlight (strictly monotonic, 0 at sunset)
        float sunLambert = clamp(sunDot * 1.25, 0.0, 1.0);

        // Sunset / Sunrise atmospheric reddening (Rayleigh extinction along path through atmosphere)
        float3 sunsetColor = float3(1.00, 0.65, 0.28);
        float3 directSunColor = mix(sunsetColor, float3(1.0, 0.98, 0.95), smoothstep(0.02, 0.20, sunDot));

        // =========================================================
        // 2. TEXTURE SAMPLES & SURFACE LIGHTING
        // =========================================================
        float4 daySample = texture(materialParams_dayMap, uv);
        float4 nightSample = texture(materialParams_nightMap, uv);
        float4 borderSample = texture(materialParams_borderMap, uv);
        float4 cloudSample = texture(materialParams_cloudMap, uv);

        // Natural cloud density curve with toggleable showClouds parameter
        float rawCloud = (cloudSample.a < 0.99 && cloudSample.a > 0.01) ? cloudSample.a : cloudSample.r;

        // Edge seam suppression for satellite coverage gaps on the Pacific dateline (u=0 / u=1)
        float datelineDist = min(uv.x, 1.0 - uv.x);
        float gapSuppression = smoothstep(0.002, 0.030, datelineDist);
        float filteredCloud = (rawCloud > 0.88) ? mix(rawCloud * 0.45, rawCloud, gapSuppression) : rawCloud;

        // Polar masking: cleanly fade out satellite clouds south and north of continents
        // Southern fade: 1.0 down to -44° S, fades to 0.0 by -52° S (eliminates Southern Ocean & Antarctica whiteout)
        // Northern fade: 1.0 up to +68° N, fades to 0.0 by +78° N (preserves Canada/Europe, eliminates Arctic whiteout)
        float latDeg = (uv.y - 0.5) * 180.0;
        float northMask = 1.0 - smoothstep(68.0, 78.0, latDeg);
        float southMask = smoothstep(-52.0, -44.0, latDeg);
        float poleMask = northMask * southMask;

        // Clean cloud alpha curve: eliminates low-level ocean grey floor (<0.32) and caps at 0.84
        float cloudAlpha = smoothstep(0.32, 0.85, filteredCloud) * 0.84 * poleMask * materialParams.showClouds;

        // Cloud shadow on Earth surface (only in daylight, only if clouds visible)
        float2 shadowUv = uv - float2(sunDir.x, -sunDir.y) * 0.0035;
        float4 shadowSample = texture(materialParams_cloudMap, shadowUv);
        float rawShadow = (shadowSample.a < 0.99 && shadowSample.a > 0.01) ? shadowSample.a : shadowSample.r;
        float shadowAlpha = smoothstep(0.32, 0.85, rawShadow) * 0.65 * poleMask * materialParams.showClouds;
        float shadowFactor = 1.0 - shadowAlpha * 0.55 * max(sunDot, 0.0);

        // Specular sun glint on ocean: strictly confined to open ocean, strictly daytime, physically bounded
        float isOcean = clamp((daySample.b - max(daySample.r, daySample.g) - 0.02) * 10.0, 0.0, 1.0);
        float sunAboveHorizon = smoothstep(0.01, 0.10, sunDot);
        float3 reflected = reflect(-sunDir, normal);
        float specAngle = max(dot(reflected, eyeDir), 0.0);
        float sunGlint = pow(specAngle, 128.0) * isOcean * sunAboveHorizon * (1.0 - cloudAlpha);
        float3 glintColor = directSunColor * sunGlint * 0.85;

        // Night city lights occlusion by clouds:
        float cloudLightBlock = smoothstep(0.15, 0.85, cloudAlpha) * 0.85;
        float3 nightLights = nightSample.rgb * 2.8 * (1.0 - cloudLightBlock);
        // Soft under-cloud city light scatter
        float3 cityUnderGlow = nightSample.rgb * 0.35 * cloudAlpha;

        // Day surface lighting: physical Lambert falloff ensures daylight smoothly and monotonically fades to dusk
        float surfaceDayLight = mix(0.04, 1.0, sunLambert);
        float3 surfaceDay = daySample.rgb * shadowFactor * directSunColor * surfaceDayLight + glintColor;

        // Night terrain ambient starlight
        float3 nightAmbient = daySample.rgb * 0.018 * float3(0.35, 0.50, 0.75);
        float3 surfaceNight = nightLights + nightAmbient;
        float3 surfaceColor = mix(surfaceNight, surfaceDay, dayFactor);

        // =========================================================
        // 3. REALISTIC 3D CLOUDS (DAY, SUNSET & NIGHT)
        // =========================================================
        float cloudSunDot = sunDot + 0.03;
        float cloudSunFactor = smoothstep(-0.04, 0.08, cloudSunDot);

        float stormHeight = smoothstep(0.4, 0.9, cloudAlpha) * materialParams.cloudRelief;
        float cloudDiffuse = clamp(sunLambert * 1.1 + stormHeight * 0.20, 0.0, 1.0);

        // Daylight clouds: crisp white with realistic ambient shading (monotonically dims with sun height)
        float3 cloudDayColor = mix(float3(0.55, 0.65, 0.78), float3(0.98, 0.99, 1.0), cloudDiffuse) * (0.15 + 0.85 * cloudDiffuse);

        // Sunset clouds: subtle amber warmth, dimmed in line with lower solar angle
        float sunsetBand = smoothstep(-0.02, 0.05, sunDot) * (1.0 - smoothstep(0.05, 0.18, sunDot));
        float3 cloudSunsetColor = sunsetColor * 0.75;
        float3 cloudLitColor = mix(cloudDayColor, cloudSunsetColor, sunsetBand * 0.80);

        // Night side clouds in Earth shadow
        float3 cloudNightColor = float3(0.010, 0.014, 0.020) + cityUnderGlow;

        // Final cloud color blended smoothly across terminator into night
        float3 cloudColor = mix(cloudNightColor, cloudLitColor, cloudSunFactor);

        // Apply clouds over Earth surface
        surfaceColor = mix(surfaceColor, cloudColor, cloudAlpha);

        // Final surface color: crystal-clear terrain and clouds, no artificial surface glow
        float3 finalColor = surfaceColor;

        // =========================================================
        // 5. INVERTED HIGH-CONTRAST BORDERS & COUNTRY LABELS
        // =========================================================
        if (materialParams.showBorders > 0.01 && borderSample.a > 0.01) {
            // Luminance of the underlying pixel (surface, clouds, city lights, atmosphere)
            float bgLum = dot(finalColor, float3(0.299, 0.587, 0.114));

            // Dynamic inverted color of the underlying surface
            float3 invertedColor = float3(1.0) - finalColor;

            // Guaranteed high-contrast target (pure dark charcoal on bright surfaces, luminous bright on dark)
            float3 highContrast = (bgLum > 0.42) 
                ? float3(0.08, 0.10, 0.14) 
                : float3(0.92, 0.96, 1.00);

            // Blend inverted with high-contrast target for maximum legibility and style
            float3 borderCol = mix(invertedColor, highContrast, 0.75);

            // Clean anti-aliased border alpha blending
            float borderAlpha = borderSample.a * materialParams.showBorders;
            finalColor = mix(finalColor, borderCol, borderAlpha);
        }

        material.baseColor = float4(finalColor, 1.0);
    }
}
