material {
    name : EarthAtmosphere,
    shadingModel : unlit,
    blending : opaque,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : dayMap },
        { type : sampler2d, name : nightMap },
        { type : sampler2d, name : cloudMap },
        { type : sampler2d, name : borderMap },
        { type : float3, name : sunDirection },
        { type : float, name : time },
        { type : float, name : cloudRelief },
        { type : float, name : showBorders },
        { type : float, name : showClouds }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = getUV0();
        // Spherical surface normal calculated analytically from equirectangular UV:
        // u=0 is -180 deg, u=0.5 is Prime Meridian (0 deg, +X), u=1 is +180 deg
        // v=0 is South Pole (-Y), v=1 is North Pole (+Y)
        float phi = (uv.x - 0.5) * 6.28318530718;
        float theta = (1.0 - uv.y) * 3.14159265359;
        float sinTheta = sin(theta);
        float3 normal = float3(sinTheta * cos(phi), cos(theta), sinTheta * sin(phi));
        float3 eyeDir = normalize(getWorldViewVector());
        float3 sunDir = normalize(materialParams.sunDirection);

        float NdotV = clamp(dot(normal, eyeDir), 0.0, 1.0);
        float sunDot = dot(normal, sunDir);

        // =========================================================
        // 1. DAY / TWILIGHT / NIGHT TRANSITION & SUNSET SPECTRUM
        // =========================================================
        // Ground daylight factor: smooth transition across the terminator [-0.06, 0.08]
        float dayFactor = smoothstep(-0.06, 0.08, sunDot);

        // Sunset / Sunrise twilight factor: peaks right along the terminator line
        float sunsetBand = smoothstep(-0.16, -0.01, sunDot) * (1.0 - smoothstep(0.02, 0.16, sunDot));

        // Atmospheric sunset color gradient:
        // Deep twilight crimson -> fiery orange-red -> golden hour amber -> daylight
        float sunsetGrad = clamp((sunDot + 0.14) / 0.22, 0.0, 1.0);
        float3 sunsetColor = mix(
            float3(0.90, 0.24, 0.10), // Deep twilight crimson
            float3(1.00, 0.68, 0.22), // Golden hour amber
            sunsetGrad
        );

        // Direct sunlight color incorporating sunset reddening near the horizon
        float3 directSunColor = mix(sunsetColor, float3(1.0, 0.98, 0.95), smoothstep(0.03, 0.18, sunDot));

        // =========================================================
        // 2. TEXTURE SAMPLES & SURFACE LIGHTING
        // =========================================================
        float4 daySample = texture(materialParams_dayMap, uv);
        float4 nightSample = texture(materialParams_nightMap, uv);
        float4 borderSample = texture(materialParams_borderMap, uv);
        float4 cloudSample = texture(materialParams_cloudMap, uv);

        // Natural cloud density curve with toggleable showClouds parameter
        float rawCloud = (cloudSample.a < 0.99 && cloudSample.a > 0.01) ? cloudSample.a : cloudSample.r;

        // Edge seam suppression for satellite coverage gaps on the Pacific dateline (u=0 / u=1)
        float datelineDist = min(uv.x, 1.0 - uv.x);
        float gapSuppression = smoothstep(0.002, 0.040, datelineDist);
        float filteredCloud = (rawCloud > 0.86) ? mix(rawCloud * 0.35, rawCloud, gapSuppression) : rawCloud;

        // Polar fade to eliminate satellite infrared whiteout and missing polar data:
        // Geostationary satellites sit above the equator and have severe coverage distortion/artifacts beyond 50 degrees.
        // The natural NASA Blue Marble day texture already provides detailed photorealistic ice caps for Antarctica and the Arctic.
        float southPoleDist = max((uv.y - 0.5) * 2.0, 0.0); // 0 at equator, 1 at South Pole (-90°)
        float northPoleDist = max((0.5 - uv.y) * 2.0, 0.0); // 0 at equator, 1 at North Pole (+90°)
        
        // South pole: smooth fade starting at 44° S, fully 0 by 56° S (eliminates Antarctic/Southern Ocean sensor whiteout)
        float southMask = 1.0 - smoothstep(0.48, 0.62, southPoleDist);
        // North pole: smooth fade starting at 52° N, fully 0 by 66° N (eliminates Arctic missing data whiteout)
        float northMask = 1.0 - smoothstep(0.57, 0.73, northPoleDist);
        float poleMask = northMask * southMask;

        // Clean cloud alpha curve: eliminates low-level ocean grey floor (<0.34) and caps at 0.82 to prevent snowballs
        float cloudAlpha = smoothstep(0.34, 0.86, filteredCloud) * 0.82 * poleMask * materialParams.showClouds;

        // Cloud shadow on Earth surface (only in daylight, only if clouds visible)
        float2 shadowUv = uv - float2(sunDir.x, -sunDir.y) * 0.0035;
        float4 shadowSample = texture(materialParams_cloudMap, shadowUv);
        float rawShadow = (shadowSample.a < 0.99 && shadowSample.a > 0.01) ? shadowSample.a : shadowSample.r;
        float shadowAlpha = smoothstep(0.34, 0.86, rawShadow) * 0.70 * poleMask * materialParams.showClouds;
        float shadowFactor = 1.0 - shadowAlpha * 0.60 * max(sunDot, 0.0);

        // Specular sun glint on ocean (tight physically-accurate specular highlight)
        float oceanMask = clamp((daySample.b - max(daySample.r, daySample.g) * 0.85) * 4.0, 0.0, 1.0);
        float3 reflected = reflect(-eyeDir, normal);
        float specAngle = max(dot(reflected, sunDir), 0.0);
        float sunGlint = pow(specAngle, 120.0) * oceanMask * max(sunDot, 0.0) * (1.0 - cloudAlpha);
        float3 glintColor = directSunColor * sunGlint * 1.2;

        // Night city lights occlusion by clouds:
        // When clouds are dense, city lights are dimmed/blocked from reaching space!
        float cloudLightBlock = smoothstep(0.15, 0.85, cloudAlpha) * 0.85;
        float3 nightLights = nightSample.rgb * 2.8 * (1.0 - cloudLightBlock);
        // Soft under-cloud city light scatter (subtle diffuse glow on cloud bottom)
        float3 cityUnderGlow = nightSample.rgb * 0.35 * cloudAlpha;

        // Day surface with sunset tint & glint vs Night city lights
        float3 surfaceDay = daySample.rgb * shadowFactor * directSunColor + glintColor;
        // Night terrain ambient starlight/airglow: darkened by > factor 2 for realistic night depth in space
        float3 nightAmbient = daySample.rgb * 0.035 * float3(0.40, 0.55, 0.80);
        float3 surfaceNight = nightLights + nightAmbient;
        float3 surfaceColor = mix(surfaceNight, surfaceDay, dayFactor);

        // =========================================================
        // 3. REALISTIC 3D CLOUDS (DAY, SUNSET & NIGHT)
        // =========================================================
        // Cloud lighting geometry: cloud tops (altitude 10 km) catch sun down to sunDot = -0.12
        float cloudSunDot = sunDot + 0.06;
        float cloudSunFactor = smoothstep(-0.14, 0.12, cloudSunDot);

        float stormHeight = smoothstep(0.4, 0.9, cloudAlpha) * materialParams.cloudRelief;
        float cloudDiffuse = max(sunDot + stormHeight * 0.20, 0.0);

        // Daylight clouds: crisp white with realistic ambient and relief shading
        float3 cloudDayColor = mix(float3(0.68, 0.77, 0.88), float3(0.98, 0.99, 1.0), clamp(cloudDiffuse * 1.1, 0.0, 1.0)) * (1.0 + stormHeight * 0.25);

        // Sunset / Twilight clouds: illuminated by long-path reddened sunlight
        float3 cloudSunsetColor = sunsetColor * (1.25 + stormHeight * 0.35);
        float cloudSunsetMix = smoothstep(-0.12, 0.03, sunDot) * (1.0 - smoothstep(0.04, 0.20, sunDot));

        // Combined sunlit cloud color
        float3 cloudLitColor = mix(cloudDayColor, cloudSunsetColor, cloudSunsetMix * 0.92);

        // Night side clouds (in Earth's shadow): darkened by factor 2.5
        float3 cloudNightColor = float3(0.012, 0.018, 0.026) + cityUnderGlow;

        // Final cloud color blended smoothly across terminator into night
        float3 cloudColor = mix(cloudNightColor, cloudLitColor, cloudSunFactor);

        // Apply clouds over Earth surface
        surfaceColor = mix(surfaceColor, cloudColor, cloudAlpha);

        // =========================================================
        // 4. ATMOSPHERE: SUBTLE GRAZING LIMB & SUNSET GLOW
        // =========================================================
        // Rim angle (1.0 at planetary limb / horizon, 0.0 at center disk)
        float rim = 1.0 - NdotV;

        // Grazing silhouette edge: only at the absolute outer edge of the planetary horizon (no milkiness over land)
        float limbIntensity = pow(rim, 32.0) * 0.15;

        // Daytime electric blue Rayleigh scattering
        float3 rayleighBlue = float3(0.18, 0.58, 1.0);

        // Sunset rim color: fiery orange/crimson along the terminator limb
        float limbSunsetFactor = smoothstep(-0.18, 0.02, sunDot) * (1.0 - smoothstep(0.02, 0.22, sunDot));
        float3 limbSunsetColor = mix(float3(0.96, 0.26, 0.08), float3(1.00, 0.62, 0.16), sunsetGrad);

        // Combined limb color: electric blue on day side, fiery sunset at terminator, soft deep navy airglow at night
        float3 limbColor = mix(rayleighBlue, limbSunsetColor, limbSunsetFactor * 0.95);
        float3 airglowNight = float3(0.008, 0.020, 0.035);
        float3 activeLimbColor = mix(airglowNight, limbColor, smoothstep(-0.25, 0.05, sunDot));

        float3 atmosphereGlow = activeLimbColor * limbIntensity * (0.16 + 0.84 * max(sunDot + 0.22, 0.0));

        // Twilight Terminator Arc: only visible along the grazing limb/horizon, not flat on the ground
        float terminatorGlow = pow(sunsetBand, 1.5) * pow(rim, 16.0) * 0.20;
        float3 terminatorAtmosphere = sunsetColor * terminatorGlow;

        // Final Composite Color: pure crystal-clear surface + clouds, with crisp horizon edge
        float3 finalColor = surfaceColor + atmosphereGlow + terminatorAtmosphere;

        // =========================================================
        // 5. INVERTED HIGH-CONTRAST BORDERS & COUNTRY LABELS
        // =========================================================
        if (materialParams.showBorders > 0.01 && borderSample.a > 0.01) {
            // Luminance of the underlying pixel (surface, clouds, city lights, atmosphere)
            float bgLum = dot(finalColor, float3(0.299, 0.587, 0.114));

            // Dynamic inverted color of the underlying surface
            float3 invertedColor = float3(1.0) - finalColor;

            // Guaranteed high-contrast target (pure dark charcoal on bright surfaces, luminous bright on dark)
            float3 highContrast = (bgLum > 0.42) 
                ? float3(0.08, 0.10, 0.14) 
                : float3(0.92, 0.96, 1.00);

            // Blend inverted with high-contrast target for maximum legibility and style
            float3 borderCol = mix(invertedColor, highContrast, 0.75);

            // Clean anti-aliased border alpha blending
            float borderAlpha = borderSample.a * materialParams.showBorders;
            finalColor = mix(finalColor, borderCol, borderAlpha);
        }

        material.baseColor = float4(finalColor, 1.0);
    }
}
