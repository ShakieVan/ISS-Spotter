<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_dark">

    <!-- 1. ISS ORBIT VIEW CONTAINER -->
    <FrameLayout
        android:id="@+id/issViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <de.shakie.iss.graphics.IssFilamentView
            android:id="@+id/filamentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <de.shakie.iss.graphics.IssGlobeOverlayView
            android:id="@+id/globeOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Controls in ISS Orbit View -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="end"
            android:orientation="vertical">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetOrbitView"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginBottom="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:background="@drawable/bg_hud_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="⟲ Ansicht zurücksetzen"
                android:textAllCaps="false"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Aufklappmenü für Ansicht und Ebenen -->
            <LinearLayout
                android:id="@+id/layoutViewOptionsMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_telemetry_card"
                android:gravity="end"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:text="ANSICHT &amp; EBENEN"
                    android:textColor="#8FAEC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleMapSource"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginBottom="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:background="@drawable/bg_hud_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🌍 Karte: Blue Marble"
                    android:textAllCaps="false"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleBorders"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginBottom="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:background="@drawable/bg_hud_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🌐 Grenzen: AN"
                    android:textAllCaps="false"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleGroundMarker"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginBottom="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:background="@drawable/bg_hud_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🎯 Bodenpunkt: AUS"
                    android:textAllCaps="false"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Aufklappmenü Schalter-Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleViewOptions"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:background="@drawable/bg_hud_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🎛️ Optionen ▴"
                android:textAllCaps="false"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 2. OBSERVER GROUND / AR VIEW CONTAINER -->
    <FrameLayout
        android:id="@+id/observerViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- CameraX Live Preview with compatible TextureView mode -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <!-- AR Callout, Starry Sky and Starfleet Arrow Overlay -->
        <de.shakie.iss.observer.IssCalloutOverlayView
            android:id="@+id/calloutOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Control in Observer View -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToggleSkyMode"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hud_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✦ Sternenhimmel"
            android:textAllCaps="false"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- 3. TOP TELEMETRY HUD CARD -->
    <LinearLayout
        android:id="@+id/telemetryCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_telemetry_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="ISS TELEMETRIE"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Sunlight / Eclipse Status Badge -->
            <TextView
                android:id="@+id/tvSunlightStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#3300B894"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="● IM SONNENLICHT"
                android:textColor="@color/green_sunlight"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrbitCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:text="LAT: 48.24° N  LON: 11.58° E  ALT: 418.5 km"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOverflight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="ÜBERFLIEGT: Berechnung..."
            android:textColor="@color/cyan_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvObserverRelative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="SPEED: 27,600 km/h  DISTANZ: 680 km  AZ/EL: 142° / +38°"
            android:textColor="@color/hud_text_dim"
            android:textSize="11sp" />

        <!-- Next Pass Row (Requested feature 6) -->
        <TextView
            android:id="@+id/tvNextPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="NÄCHSTER ÜBERFLUG: Berechnung läuft..."
            android:textColor="@color/gold_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. BOTTOM NAVIGATION / VIEW SWITCHER BAR -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="#F0050A14"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeIss"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_button_active"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🛰️ Ansicht\nvon der ISS"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeObserver"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_button_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🔭 Ansicht\nvom Betrachter"
            android:textAllCaps="false"
            android:textColor="#8FAEC8"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
